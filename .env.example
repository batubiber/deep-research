#==============================================================================
# Deep Research — environment configuration
#
# Copy to .env and fill in.  Defaults live in app/config.py; anything you leave
# blank here falls back to that.  .env is gitignored — keep it that way.
#==============================================================================

#------------------------------------------------------------------------------
# REQUIRED
#------------------------------------------------------------------------------

# OpenAI-compatible LLM endpoint (vLLM, SGLang, or any compatible server).
# No default in code on purpose — this belongs here, never committed.
VLLM_BASE_URL=https://your-endpoint.example.com/v1
VLLM_API_KEY=
VLLM_MODEL_NAME=qwen3-5

# Web search. Get a key at https://tavily.com
TAVILY_API_KEY=

#------------------------------------------------------------------------------
# SEARCH
#------------------------------------------------------------------------------

# "basic" = 1 credit/search, "advanced" = 2 credits, noticeably better relevance
TAVILY_SEARCH_DEPTH=advanced

# Return full page markdown inline. Costs nothing extra and removes a Jina
# round-trip for most pages.
TAVILY_INCLUDE_RAW_CONTENT=true

# ArXiv: abstracts are cheap, full HTML is not. Fetch broadly, enrich selectively.
ARXIV_RESULTS_PER_SEARCH=10
ARXIV_ENRICH_COUNT=7

# Per-researcher search loop
RESEARCHER_MAX_ROUNDS=3
RESEARCHER_RESULTS_PER_SEARCH=7

#------------------------------------------------------------------------------
# OPTIONAL SOURCES — leave blank to disable
#------------------------------------------------------------------------------

# Jina Reader: page extraction where Tavily raw content is unavailable.
# Works unauthenticated at a lower rate limit.
JINA_API_KEY=

# Reddit: no auth needed, just a UA string.
REDDIT_USER_AGENT=DeepResearch/0.1.0

# X/Twitter: cookie auth from a logged-in session.
#
# WARNING — these two values are full session credentials for that account.
# Anyone who obtains them can act as you on X. Never commit them, never paste
# them into an issue or a log, and rotate by logging out if they leak.
# Scraping X this way is also against its Terms of Service; leave blank unless
# you have a reason.
TWITTER_CT0=
TWITTER_AUTH_TOKEN=

#------------------------------------------------------------------------------
# REASONING BUDGETS (tokens)
#
# Budget tracks how much material an agent has to chew on, not how important it
# is. The Reviewer makes the pipeline's sharpest judgment call and still gets
# the smallest budget — its output is a score plus at most three gap statements.
# The Writer gets 16x the Planner because it synthesizes everything upstream
# into the longest artifact in the run.
#
# Sized against a 265k context window. Raise these together with the model, not
# individually.
#------------------------------------------------------------------------------

THINKING_BUDGET_PLANNER=1024
THINKING_BUDGET_REVIEWER=1024
THINKING_BUDGET_CITATION_VERIFIER=1024
THINKING_BUDGET_SUMMARIZER=2048
THINKING_BUDGET_ANALYST=4096
THINKING_BUDGET_GAP_RESEARCHER=4096
THINKING_BUDGET_RESEARCHER=8192
THINKING_BUDGET_WRITER=16384

#------------------------------------------------------------------------------
# SAMPLING TEMPERATURE
#
# Retrieval and judgment should be reproducible; only prose gets latitude.
#------------------------------------------------------------------------------

TEMPERATURE_PLANNER=0.1
TEMPERATURE_RESEARCHER=0.1
TEMPERATURE_REVIEWER=0.1
TEMPERATURE_GAP_RESEARCHER=0.1
TEMPERATURE_SUMMARIZER=0.1
TEMPERATURE_ANALYST=0.2
TEMPERATURE_WRITER=0.2

#------------------------------------------------------------------------------
# RUNTIME
#------------------------------------------------------------------------------

# Concurrent researcher agents during fan-out
MAX_PARALLEL_RESEARCHERS=5

# Seconds. Sized at ~2x the worst-case single call for the served model.
LLM_TIMEOUT=90.0

#------------------------------------------------------------------------------
# API
#------------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8001

# Leave blank for local development. SET THIS before exposing the API on a
# public address — an open endpoint spends your Tavily credits and your GPU.
API_KEY=

# JSON list. Add your deployed front end when you have one.
CORS_ORIGINS=["http://localhost:5173"]
